# Anthropic API Key für die Claude-Vision-Produkterkennung.
# Anleitung: siehe README.md Abschnitt "Anthropic API Key erstellen".
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Claude-Modell verwenden (Standard: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Port für den lokalen Backend-Server
PORT=8787

# Postgres-Verbindung (MVP 4). Lokal z.B. via:
# createuser + createdb, siehe README Abschnitt "Postgres einrichten".
DATABASE_URL=postgresql://elektro_scanner:elektro_scanner_dev@localhost:5432/elektro_scanner

# Clerk (Team-Auth, Organisationen, Rollen). Keys aus dem Clerk-Dashboard
# (dashboard.clerk.com) -> "API Keys". Anleitung: siehe README Abschnitt
# "Clerk einrichten". Der Publishable Key ist NICHT geheim und wird deshalb
# zweimal eingetragen: einmal mit VITE_-Präfix fürs Frontend (Vite bundelt
# nur Variablen mit diesem Präfix ins Frontend), einmal ohne Präfix, weil
# das Backend (@clerk/express) exakt CLERK_PUBLISHABLE_KEY erwartet.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
