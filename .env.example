# Namen der 3 festen Mitglieder des Ländlertrios Tal-Echo, kommagetrennt (genau 3 Namen).
MEMBER_NAMES=Hans,Sepp,Vreni

# Gemeinsamer Zugangscode für die App (kein öffentlicher Zugriff).
# Bitte nach dem ersten Start ändern!
APP_PASSCODE=jodel1234

# Geheimer Schlüssel zum Signieren der Login-Sitzung (Cookie).
# Bitte durch eine zufällige, lange Zeichenfolge ersetzen.
JWT_SECRET=bitte-diesen-wert-durch-einen-zufaelligen-langen-text-ersetzen

# Port für den lokalen Backend-Server
PORT=8787
