# Anthropic API Key für die Claude-Vision-Produkterkennung.
# Anleitung: siehe README.md Abschnitt "Anthropic API Key erstellen".
ANTHROPIC_API_KEY=sk-ant-...

# Optional: anderes Claude-Modell verwenden (Standard: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Port für den lokalen Backend-Server
PORT=8787

# Zusätzlicher App-seitiger Kostenschutz (in USD): oberhalb dieses geschätzten
# Verbrauchs verweigert die App weitere Foto-Erkennungen. Ersetzt NICHT das
# harte Limit in der Anthropic Console (Settings -> Billing -> Limits) -
# dieses hier ist nur eine zusätzliche Absicherung auf App-Ebene.
SPEND_LIMIT_USD=10
